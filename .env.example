# Copy to .env or export these variables. Every one is optional.
SECRET_KEY=change-me-to-a-long-random-string      # python -c "import secrets;print(secrets.token_hex(32))"
APP_USER=
APP_PASSWORD=                                      # set BOTH to require a login
GST_HOST=127.0.0.1                                 # keep local; only change behind a reverse proxy with HTTPS
GST_PORT=5000
GST_MAX_UPLOAD_MB=25
GST_MAX_ROWS=200000
GST_RETENTION_DAYS=0                               # auto-delete reports older than N days (0 = keep)
GST_THRESHOLD=0.5
GST_DB_PATH=data/gst_reports.db
